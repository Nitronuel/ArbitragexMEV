pragma solidity ^0.8.26;

import "./FlashProbe.sol";
import "forge-std/Test.sol";

/// Fork test: PM flash accounting + nested router call against real RHC state.
contract FlashProbeTest is Test {
    FlashProbe probe;

    function setUp() public {
        probe = new FlashProbe();
    }

    /// The 1-element live route (native -> 0xccf1 via the hot V4 pool).
    /// Fork-only: needs the live PM + router (chain 4663). Skips cleanly
    /// offline instead of failing on missing fork state.
    function test_flash_nested_router() public {
        if (block.chainid != 4663) return; // requires the RHC fork
        // calldata captured from live tx 0x104ce1e5 (amountIn 0.02 native)
        bytes memory routerData = hex"";
        // Probe: borrow 0.02 native from the PM, run the route.
        try probe.probe(address(0), 0.02 ether, routerData) returns (uint256 profit) {
            emit log_named_uint("FLASH NESTING WORKS - probe profit (wei)", profit);
        } catch (bytes memory reason) {
            emit log_named_string("result", "NESTING FORBIDDEN or failed");
            emit log_named_bytes("reason", reason);
            revert("nesting test failed - see reason");
        }
    }
}
