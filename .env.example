# Names only — always empty here. Export real values in the shell that runs
# the bot; never commit a value, never pass one as a CLI argument.

# Robinhood Chain JSON-RPC (chain id 4663).
ROBINHOOD_HTTP_RPC_URL=
ROBINHOOD_WS_RPC_URL=

# Optional archive-capable provider for deep reads (old-capture verification,
# quoter calls, fork-simulation storage). Continuous polling does not use it.
ALCHEMY_RHC_HTTP_URL=

# Executor owner signing key.
ARBITRAGE_WALLET_PRIVATE_KEY=
